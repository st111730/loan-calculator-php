{
    "name": "bis-225/php-backend",
    "description": "PHP-бэкенд калькулятора кредитных заявок (миграция с Node.js/Express, контракт — docs/backend-api.md)",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S 0.0.0.0:4000 -t public public/index.php",
        "test": "phpunit"
    }
}
