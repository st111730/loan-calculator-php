# Значения по умолчанию повторяют локальные дефолты Node-версии (backend-api.md, §2).
# В Docker Compose дефолты другие (см. docker-compose.yml) — при миграции их стоит унифицировать.
# Файл читается точкой входа public/index.php из корня php-backend (vlucas/phpdotenv).

PORT=4000
PGHOST=localhost
PGPORT=5432
PGDATABASE=calc
PGUSER=calc
PGPASSWORD=calc
ADMIN_USER=admin
ADMIN_PASSWORD=admin
